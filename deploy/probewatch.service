[Unit]
Description=ProbeWatch monitoring control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=probewatch
Group=probewatch
WorkingDirectory=/opt/probewatch
EnvironmentFile=-/etc/probewatch/probewatch.env
Environment=GOMEMLIMIT=150MiB
Environment=GOGC=75
ExecStart=/opt/probewatch/probewatch
Restart=always
RestartSec=5s
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/probewatch/data
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
